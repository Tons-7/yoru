{
  "id": "/",
  "name": "Yoru",
  "short_name": "Yoru",
  "description": "Self-hosted anime streaming",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "share_target": { "action": "/open", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "shortcuts": [
    { "name": "Continue watching", "short_name": "Continue", "url": "/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Schedule", "url": "/schedule", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Downloads", "url": "/downloads", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/browse", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
